<style>
  .description {
    white-space: normal !important;
    overflow: visible !important;
    text-overflow: unset !important;
    word-wrap: normal !important;
    word-break: keep-all !important;
    hyphens: none !important;
    overflow-wrap: normal !important;
    display: block !important;
    margin-bottom: 8px;
  }

  .horizontal-divider {
    width: 100%;
    padding-top: 2px;
    padding-bottom: 2px;
    border-bottom: 1px solid #666;
  }

  .list {
    max-height: 100%;
  }

  .engagement-stats {
    display: flex;
    gap: 16px;
    align-items: flex-start;
  }

  .engagement-stats i {
    color: #666;
  }
</style>

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

<div class="layout">
  <div class="list">
    {% if timeline and timeline.size > 0 %}
      {% for post in timeline %}
        <div class="item">
          <div class="content">
            <span class="title title--small">{{ post.authorName | escape }} <span style="color: #666; font-size: 0.8em;">@{{ post.authorHandle | escape }}</span></span>
            <span class="description">{{ post.text | escape }}</span>
            <div class="engagement-stats">
              <span class="label label--small"><i class="fas fa-comment"></i> {{ post.commentCount }}</span>
              <span class="label label--small"><i class="fas fa-retweet"></i> {{ post.repostCount }}</span>
              <span class="label label--small"><i class="fas fa-heart"></i> {{ post.likeCount }}</span>
            </div>
            <div class="horizontal-divider"></div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <span class="label">Timeline</span>
      <div class="item">
        <div class="content">
          <span class="description">No posts to display.</span>
        </div>
      </div>
    {% endif %}
  </div>
</div>
<div class="title_bar">
  <svg class="image" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display: inline-block; vertical-align: middle;">
    <path d="M18.24.24H5.76A5.76 5.76 0 0 0 0 6v12a5.76 5.76 0 0 0 5.76 5.76h12.48A5.76 5.76 0 0 0 24 18V6A5.76 5.76 0 0 0 18.24.24m.816 17.166v.504a.49.49 0 0 1-.486.49h-1.474a.49.49 0 0 1-.49-.49v-4.344a3.67 3.67 0 0 0-1.12-2.656 3.65 3.65 0 0 0-2.61-.956h-.752a3.65 3.65 0 0 0-2.61.956 3.67 3.67 0 0 0-1.12 2.656v4.344a.49.49 0 0 1-.49.49H6.03a.49.49 0 0 1-.49-.49v-.504a4.12 4.12 0 0 1 1.056-2.79 4.14 4.14 0 0 1 2.92-1.282h.334a1.86 1.86 0 0 0 1.29-.53 1.87 1.87 0 0 0 .53-1.32V8.498a.49.49 0 0 1 .49-.49h1.74a.49.49 0 0 1 .49.49v2.79a1.87 1.87 0 0 0 .53 1.32 1.86 1.86 0 0 0 1.29.53h.334a4.14 4.14 0 0 1 2.92 1.282 4.12 4.12 0 0 1 1.056 2.79"/>
  </svg>
  <span class="title">Farcaster Timeline</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
