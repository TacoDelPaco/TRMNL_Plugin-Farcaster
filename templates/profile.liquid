<style>
  .profile-header {
    position: relative;
    margin-bottom: 20px;
  }

  .banner {
    width: 100%;
    height: 200px;
    object-fit: cover;
    border-radius: 8px;
  }

  .profile-info {
    position: relative;
    padding: 0 16px;
  }

  .avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 4px solid white;
    position: absolute;
    top: -48px;
    left: 16px;
  }

  .profile-stats {
    display: flex;
    gap: 24px;
    margin: 16px 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .stat-value {
    font-weight: bold;
    font-size: 1.2em;
  }

  .stat-label {
    color: #666;
    font-size: 0.9em;
  }

  .description {
    white-space: pre-wrap;
    margin: 16px 0;
    line-height: 1.5;
  }

  .handle {
    color: #666;
    margin-bottom: 8px;
  }

  .display-name {
    font-size: 1.5em;
    font-weight: bold;
    margin-bottom: 8px;
  }
</style>

<div class="layout">
  <div class="profile-header">
    <div class="profile-info" style="padding-top: 24px; display: flex; align-items: center; justify-content: center; gap: 16px;">
      {% if avatar %}
        <img class="avatar" src="{{ avatar }}" alt="{{ displayName }}'s avatar" width="64" height="64" style="position: static; display: block; margin: 0;">
      {% endif %}
      <div style="text-align: left;">
        <div class="display-name" style="margin-bottom: 2px;">{{ displayName | escape }}</div>
        <div class="handle" style="margin-bottom: 0;">@{{ handle | escape }}</div>
      </div>
    </div>
    <div class="profile-stats" style="justify-content: center; margin: 8px 0 0 0; display: flex; gap: 24px;">
      <div class="stat">
        <span class="stat-value">{{ followersCount }}</span>
        <span class="stat-label">Followers</span>
      </div>
      <div class="stat">
        <span class="stat-value">{{ followsCount }}</span>
        <span class="stat-label">Following</span>
      </div>
      <div class="stat">
        <span class="stat-value">{{ postsCount }}</span>
        <span class="stat-label">Posts</span>
      </div>
    </div>
  </div>
</div>

<div class="title_bar">
  <svg class="image" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display: inline-block; vertical-align: middle;">
    <path d="M18.24.24H5.76A5.76 5.76 0 0 0 0 6v12a5.76 5.76 0 0 0 5.76 5.76h12.48A5.76 5.76 0 0 0 24 18V6A5.76 5.76 0 0 0 18.24.24m.816 17.166v.504a.49.49 0 0 1-.486.49h-1.474a.49.49 0 0 1-.49-.49v-4.344a3.67 3.67 0 0 0-1.12-2.656 3.65 3.65 0 0 0-2.61-.956h-.752a3.65 3.65 0 0 0-2.61.956 3.67 3.67 0 0 0-1.12 2.656v4.344a.49.49 0 0 1-.49.49H6.03a.49.49 0 0 1-.49-.49v-.504a4.12 4.12 0 0 1 1.056-2.79 4.14 4.14 0 0 1 2.92-1.282h.334a1.86 1.86 0 0 0 1.29-.53 1.87 1.87 0 0 0 .53-1.32V8.498a.49.49 0 0 1 .49-.49h1.74a.49.49 0 0 1 .49.49v2.79a1.87 1.87 0 0 0 .53 1.32 1.86 1.86 0 0 0 1.29.53h.334a4.14 4.14 0 0 1 2.92 1.282 4.12 4.12 0 0 1 1.056 2.79"/>
  </svg>
  <span class="title">Farcaster Profile</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
