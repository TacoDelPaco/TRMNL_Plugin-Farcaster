<div class="layout">
  <div class="list">
    {% if trends and trends.size > 0 %}
      {% for trend in trends %}
        <div class="item flex flex--space-between" style="align-items: center; justify-content: space-between;">
          <div class="flex" style="align-items: center; gap: 1rem;">
            <span class="index">{{ forloop.index }}</span>
            <span class="title title--small">{{ trend.displayName | escape }}</span>
            <span class="description">
              {% if trend.postCount >= 1000 %}
                {{ trend.postCount | divided_by: 1000.0 | round: 1 }}k posts
              {% else %}
                {{ trend.postCount }} posts
              {% endif %}
            </span>
          </div>
          <div style="margin-left: auto;">
            {% if trend.status and trend.status == 'hot' %}
              <span class="label label--small">Trending now</span>
            {% else %}
              {% assign started_at_seconds = trend.startedAt | date: '%s' | times: 1 %}
              {% assign now_seconds = 'now' | date: '%s' | times: 1 %}
              {% assign duration_in_seconds = now_seconds | minus: started_at_seconds %}

              {% if duration_in_seconds < 0 %}{% assign duration_in_seconds = 0 %}{% endif %}

              {% assign hours_ago = duration_in_seconds | divided_by: 3600 %}
              <span class="label label--small label--underline">{{ hours_ago }}h ago</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% else %}
      <span class="label">Trending Topics</span>
      <div class="item">
        <div class="content">
          <span class="description">No topics are currently trending.</span>
        </div>
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <svg class="image" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="display: inline-block; vertical-align: middle;">
    <path d="M18.24.24H5.76A5.76 5.76 0 0 0 0 6v12a5.76 5.76 0 0 0 5.76 5.76h12.48A5.76 5.76 0 0 0 24 18V6A5.76 5.76 0 0 0 18.24.24m.816 17.166v.504a.49.49 0 0 1-.486.49h-1.474a.49.49 0 0 1-.49-.49v-4.344a3.67 3.67 0 0 0-1.12-2.656 3.65 3.65 0 0 0-2.61-.956h-.752a3.65 3.65 0 0 0-2.61.956 3.67 3.67 0 0 0-1.12 2.656v4.344a.49.49 0 0 1-.49.49H6.03a.49.49 0 0 1-.49-.49v-.504a4.12 4.12 0 0 1 1.056-2.79 4.14 4.14 0 0 1 2.92-1.282h.334a1.86 1.86 0 0 0 1.29-.53 1.87 1.87 0 0 0 .53-1.32V8.498a.49.49 0 0 1 .49-.49h1.74a.49.49 0 0 1 .49.49v2.79a1.87 1.87 0 0 0 .53 1.32 1.86 1.86 0 0 0 1.29.53h.334a4.14 4.14 0 0 1 2.92 1.282 4.12 4.12 0 0 1 1.056 2.79"/>
  </svg>
  <span class="title">Farcaster Trends</span>
  <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
</div>
